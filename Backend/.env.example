# Server port (optional — defaults to 5000)
PORT=5000

# Google Gemini API key (required for AI-powered audit analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed frontend origin for CORS (optional)
# Local dev defaults to http://localhost:5173
# Production defaults to https://staticpulse-v1.vercel.app
# No trailing slash.
CORS_ORIGIN=http://localhost:5173
